extends layout

block content
  style.
    #buy-orders_wrapper .dataTables_scrollBody,
    #sell-orders_wrapper .dataTables_scrollBody {
      overflow-y: scroll !important;
      scrollbar-width: thin;
      scrollbar-color: rgba(13,110,253,0.65) rgba(13,110,253,0.12);
      border-right: 1px solid rgba(13,110,253,0.25);
    }

    #buy-orders_wrapper .dataTables_scrollBody::-webkit-scrollbar,
    #sell-orders_wrapper .dataTables_scrollBody::-webkit-scrollbar {
      width: 10px;
    }

    #buy-orders_wrapper .dataTables_scrollBody::-webkit-scrollbar-track,
    #sell-orders_wrapper .dataTables_scrollBody::-webkit-scrollbar-track {
      background: rgba(13,110,253,0.12);
      border-radius: 999px;
    }

    #buy-orders_wrapper .dataTables_scrollBody::-webkit-scrollbar-thumb,
    #sell-orders_wrapper .dataTables_scrollBody::-webkit-scrollbar-thumb {
      background: rgba(13,110,253,0.65);
      border-radius: 999px;
      border: 2px solid rgba(13,110,253,0.12);
    }

    #buy-orders_wrapper .dataTables_scrollBody::-webkit-scrollbar-thumb:hover,
    #sell-orders_wrapper .dataTables_scrollBody::-webkit-scrollbar-thumb:hover {
      background: rgba(13,110,253,0.85);
    }

    /* right-align numeric/float cells across markets page */
    #buy-orders tbody td,
    #sell-orders tbody td,
    #history-table tbody td:nth-child(1),
    #history-table tbody td:nth-child(2),
    #history-table tbody td:nth-child(3),{
      text-align: right !important;
      font-variant-numeric: tabular-nums;
    }

    #depth-hover-value,
    #price-hover-value {
      min-height: 1.2rem;
      font-size: 0.82rem;
      line-height: 1.2rem;
      color: var(--bs-secondary-color, #6c757d);
      margin-bottom: 0.25rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    #depth-hover-value {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      white-space: nowrap;
      overflow: hidden;
    }

    #depth-hover-value .depth-hover-side {
      overflow: hidden;
      text-overflow: ellipsis;
    }

    #depth-hover-value .depth-hover-buy {
      color: rgba(80, 160, 115, 0.95);
      text-align: left;
      flex: 1 1 50%;
    }

    #depth-hover-value .depth-hover-sell {
      color: rgba(215, 85, 65, 0.95);
      text-align: right;
      flex: 1 1 50%;
    }

    #price-hover-value {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      white-space: nowrap;
      overflow: hidden;
    }

    #price-hover-value .price-hover-part {
      overflow: hidden;
      text-overflow: ellipsis;
    }

    #price-hover-value .price-hover-bid {
      color: rgba(80, 160, 115, 0.95);
      text-align: left;
      flex: 1 1 30%;
    }

    #price-hover-value .price-hover-last {
      color: rgba(255, 255, 255, 0.95);
      text-align: center;
      flex: 1 1 40%;
    }

    #price-hover-value .price-hover-ask {
      color: rgba(215, 85, 65, 0.95);
      text-align: right;
      flex: 1 1 30%;
    }

    #market-root.market-depth-mode-quote .cumulative-coin-col {
      display: none !important;
    }

    #market-root.market-depth-mode-base .cumulative-coin-col {
      display: table-cell !important;
    }

    #market-root.market-depth-mode-base .cumulative-quote-col {
      display: none !important;
    }

  script.
    $(document).ready(function() {
      if ('#{settings.markets_page.page_header.show_last_updated}' == 'true') {
        var lastUpdatedDate = #{(last_updated == null || last_updated == '0' ? 0 : last_updated)};

        if (lastUpdatedDate != 0) {
          $('span#lastUpdatedDate').html(' ' + format_unixtime(lastUpdatedDate));

          if (#{settings.shared_pages.date_time.enable_alt_timezone_tooltips} == true) {
            $('span#lastUpdatedDate').attr('data-bs-toggle', 'tooltip').attr('data-bs-placement', 'auto').attr('title', format_unixtime(lastUpdatedDate, true));
            enableTooltips();
          }
        } else
          $('span#lastUpdatedDate').html(' N/A');
      }
      if (#{settings.shared_pages.page_header.page_title_image.enable_animation} == true && #{settings.markets_page.page_header.show_img} == true)
        startRotateElementTwin('img#header-img','img#header-img-back');
    });
  - var theadClasses = [];
  - var mktDisplayDecimals = (settings.coin.decimals != null && !isNaN(settings.coin.decimals) && parseInt(settings.coin.decimals) >= 0) ? Math.min(parseInt(settings.coin.decimals), 8) : null;
  - var mktFmtOpts = {'minimumFractionDigits': (mktDisplayDecimals != null ? mktDisplayDecimals : 2), 'maximumFractionDigits': (mktDisplayDecimals != null ? mktDisplayDecimals : 8), 'useGrouping': true};
  if settings.shared_pages.table_header_bgcolor != null && settings.shared_pages.table_header_bgcolor != ''
    - theadClasses.push('table-' + settings.shared_pages.table_header_bgcolor);
  if marketdata.data != null && ((marketdata.data.buys != null && marketdata.data.buys.length > 0) || (marketdata.data.sells != null && marketdata.data.sells.length > 0) || (marketdata.data.history != null && marketdata.data.history.length > 0))
    script.
      $(document).ready(function() {
        $('.summary-table').dataTable({
          info: false,
          paging: false,
          searching: false,
          ordering: false,
          autowidth: true,
          responsive: true,
          scrollX: true,
          fnDrawCallback: function(settings) {
            fixDataTableColumns();
          }
        });
        $('.order-table').dataTable({
          info: false,
          paging: false,
          searching: false,
          ordering: false,
          scrollY: '300px',
          scrollCollapse: false,
          autowidth: true,
          responsive: true,
          scrollX: true,
          fnDrawCallback: function(settings) {
            fixDataTableColumns();
          }
        });
        $('#history-table').dataTable({
          searching: false,
          ordering: false,
          pageLength: 10,
          lengthMenu: [[10, 50, 100, 250, 500], [10, 50, 100, 250, 500]],
          responsive: true,
          scrollX: true,
          language: {
            paginate: {
              previous: '<',
              next: '>'
            }
          },
          fnDrawCallback: function(settings) {
            if ($('#history-table > tbody > tr > td > span.timestampCol').length > 0) {
              $('#history-table > tbody > tr > td > span.timestampCol').each(function() {
                if ($.isNumeric($(this).text())) {
                  if (#{settings.shared_pages.date_time.enable_alt_timezone_tooltips} == true)
                    $(this).attr('data-bs-toggle', 'tooltip').attr('data-bs-placement', 'auto').attr('title', format_unixtime(parseInt($(this).text()), true));

                  $(this).html(format_unixtime(parseInt($(this).text())));
                }
              });

              if (#{settings.shared_pages.date_time.enable_alt_timezone_tooltips} == true)
                enableTooltips();
            }

            fixDataTableColumns();
          }
        });
      });
  #market-root.col-xs-12.col-md-12.market-depth-mode-quote
    if settings.markets_page.page_header.show_img == true || settings.markets_page.page_header.show_title == true || settings.markets_page.page_header.show_last_updated == true || (settings.markets_page.page_header.show_exchange_url == true && marketdata.url != null && marketdata.url != '') || settings.markets_page.page_header.show_description == true
      #page-header-container(style='align-items:' + (settings.markets_page.page_header.show_img == true && settings.markets_page.page_header.show_title == true && ((settings.markets_page.page_header.show_last_updated == true && settings.markets_page.page_header.show_description == true) || ((settings.markets_page.page_header.show_exchange_url == true && marketdata.url != null && marketdata.url != '') && settings.markets_page.page_header.show_description == true) || ((settings.markets_page.page_header.show_exchange_url == true && marketdata.url != null && marketdata.url != '') && settings.markets_page.page_header.show_last_updated == true)) ? 'flex-start' : 'center'))
        if settings.markets_page.page_header.show_img == true
          #header-img-container
            img#header-img(src=(settings.shared_pages.page_header.page_title_image == null || settings.shared_pages.page_header.page_title_image.image_path == null || settings.shared_pages.page_header.page_title_image.image_path == '' ? '/img/page-title-img.png' : settings.shared_pages.page_header.page_title_image.image_path))
            img#header-img-back(src=(settings.shared_pages.page_header.page_title_image == null || settings.shared_pages.page_header.page_title_image.image_path2 == null || settings.shared_pages.page_header.page_title_image.image_path2 == '' ? '/img/page-title-img2.png' : settings.shared_pages.page_header.page_title_image.image_path2))
        #page-title-container
          if settings.markets_page.page_header.show_title == true
            h1#page-title !{settings.localization.mkt_title.replace('{1}', marketdata.market_name + ' <span class="small fw-normal">(' + marketdata.coin + '/' + marketdata.exchange + ')</span>')}
          if settings.markets_page.page_header.show_last_updated == true
            if settings.markets_page.page_header.show_title != true && settings.markets_page.page_header.show_description != true && (settings.markets_page.page_header.show_exchange_url != true && marketdata.url != null && marketdata.url != '')
              #page-title-container
                .sub-page-header
                  span.fw-bold=settings.localization.last_updated + ':'
                  span.text-muted#lastUpdatedDate
            else
              .sub-page-header(style='margin-bottom:' + (settings.markets_page.page_header.show_description == true || (settings.markets_page.page_header.show_exchange_url == true && marketdata.url != null && marketdata.url != '') ? '5' : '0') + 'px')
                span.fw-bold=settings.localization.last_updated + ':'
                span.text-muted#lastUpdatedDate
          if settings.markets_page.page_header.show_exchange_url == true && marketdata.url != null && marketdata.url != ''
            if settings.markets_page.page_header.show_title != true && settings.markets_page.page_header.show_last_updated != true && settings.markets_page.page_header.show_description != true
              #page-title-container
                .sub-page-header
                  span.fw-bold='Link to Exchange:'
                  a.sub-page-header(title='Link to Exchange', target='_blank', href=marketdata.url)
                    span !{' Trade <span class="small fw-normal">(' + marketdata.coin + '/' + marketdata.exchange + ')</span>'}              
            else
              .sub-page-header(style='margin-bottom:' + (settings.markets_page.page_header.show_description == true ? '5' : '0') + 'px')
                span.fw-bold='Link to Exchange:'
                a.sub-page-header(title='Link to Exchange', target='_blank', href=marketdata.url)
                  span !{' Trade <span class="small fw-normal">(' + marketdata.coin + '/' + marketdata.exchange + ')</span>'}
          if settings.markets_page.page_header.show_description == true
            if settings.markets_page.page_header.show_title != true && settings.markets_page.page_header.show_last_updated != true && (settings.markets_page.page_header.show_exchange_url != true && marketdata.url != null && marketdata.url != '')
              #page-title-container
                .sub-page-header.text-muted=settings.localization.mkt_description.replace('{1}', marketdata.coin + '/' + marketdata.exchange).replace('{2}', marketdata.market_name)
            else
              .sub-page-header.text-muted=settings.localization.mkt_description.replace('{1}', marketdata.coin + '/' + marketdata.exchange).replace('{2}', marketdata.market_name)
      .cardSpacer.clearfix
    if settings.markets_page.show_market_select == true && settings.market_count > 1
      .row
        .col-md-12.cardSpacer
          .card.card-default.border-0
            .card-header
              strong #{settings.localization.mkt_select}
            .card-body
              ul.nav.nav-pills
                each mkt in settings.market_data
                  if mkt != null && mkt.id != null
                    each pair in mkt.trading_pairs
                      if market == mkt.id && marketdata.coin.toLowerCase() + '/' + marketdata.exchange.toLowerCase() == pair.pair.toLowerCase()
                        li.nav-item
                          a.nav-link.active(href='/markets/' + mkt.id + '/' + pair.pair)
                            if pair.isAlt == true
                              if mkt.alt_logo != null && mkt.alt_logo != ''
                                img.align-top.market-logo(src='data:image/png;base64,' + mkt.alt_logo, title=mkt.alt_name + ' (' + pair.pair + ')', alt=mkt.alt_name + ' (' + pair.pair + ')')
                              else
                                i.market-logo.fa-solid.fa-circle-question
                              span #{mkt.alt_name}
                                span.small.fw-normal  (#{pair.pair})
                            else
                              if mkt.logo != null && mkt.logo != ''
                                img.align-top.market-logo(src='data:image/png;base64,' + mkt.logo, title=mkt.name + ' (' + pair.pair + ')', alt=mkt.name + ' (' + pair.pair + ')')
                              else
                                i.market-logo.fa-solid.fa-circle-question
                              span #{mkt.name}
                                span.small.fw-normal  (#{pair.pair})
                      else
                        li.nav-item
                          a.nav-link(href='/markets/' + mkt.id + '/' + pair.pair)
                            if pair.isAlt == true
                              if mkt.alt_logo != null && mkt.alt_logo != ''
                                img.align-top.market-logo(src='data:image/png;base64,' + mkt.alt_logo, title=mkt.alt_name + ' (' + pair.pair + ')', alt=mkt.alt_name + ' (' + pair.pair + ')')
                              else
                                i.market-logo.fa-solid.fa-circle-question
                              span #{mkt.alt_name}
                                span.small.fw-normal  (#{pair.pair})
                            else
                              if mkt.logo != null && mkt.logo != ''
                                img.align-top.market-logo(src='data:image/png;base64,' + mkt.logo, title=mkt.name + ' (' + pair.pair + ')', alt=mkt.name + ' (' + pair.pair + ')')
                              else
                                i.market-logo.fa-solid.fa-circle-question
                              span #{mkt.name}
                                span.small.fw-normal  (#{pair.pair})
    if marketdata.data != null && ((marketdata.data.buys != null && marketdata.data.buys.length > 0) || (marketdata.data.sells != null && marketdata.data.sells.length > 0) || (marketdata.data.history != null && marketdata.data.history.length > 0))
      block market_view
        script.
          $(document).ready(function() {
            var depthData = !{JSON.stringify((marketdata.depth_chart == null ? { bids: [], asks: [] } : marketdata.depth_chart))};
            var priceHistoryApiUrl = '#{marketdata.price_history_api_url == null ? '' : marketdata.price_history_api_url}';
            var chartData = !{(marketdata.data.chartdata == null || marketdata.data.chartdata == 'null' || marketdata.data.chartdata == '' || marketdata.data.chartdata == '[]' ? 'null' : marketdata.data.chartdata)};

            if (chartData != null) {
              chartData = chartData.map(function(item) {
                return {
                  x: item[0],
                  o: item[1],
                  h: item[2],
                  l: item[3],
                  c: item[4]
                };
              });

              const backgroundPlugin = {
                id: 'backgroundFill',
                beforeDraw(chart) {
                  const ctx = chart.ctx;
                  ctx.save();
                  ctx.fillStyle = '#FFFFFF';  // Change chart background color
                  const chartArea = chart.chartArea;
                  ctx.fillRect(chartArea.left, chartArea.top, chartArea.right - chartArea.left, chartArea.bottom - chartArea.top);
                  ctx.restore();
                }
              };

              Chart.register(backgroundPlugin);

              var ohlcvChart = new Chart('chart', {
                type: 'candlestick',
                data: {
                  datasets: [{
                    label: 'Market Data',
                    data: chartData,
                    borderColor: {
                      up: 'rgba(80, 160, 115, 1)',
                      down: 'rgba(215, 85, 65, 1)',
                      unchanged: 'rgba(90, 90, 90, 1)'
                    },
                    color: {
                      up: 'rgba(80, 160, 115, 1)',
                      down: 'rgba(215, 85, 65, 1)',
                      unchanged: 'rgba(90, 90, 90, 1)'
                    }
                  }]
                },
                options: {
                  maintainAspectRatio: true,
                  aspectRatio: 3,
                  scales: {
                    x: {
                      type: 'time',
                      offset: true,
                      ticks: {
                        padding: 10
                      }
                    },
                    y: {
                      position: 'right',
                      grace: '10%',
                      ticks: {
                        callback: function(value, index, values) {
                          return parseFloat(value).toFixed(8);
                        }
                      }
                    }
                  },
                  plugins: {
                    legend: {
                      display: false
                    },
                    tooltip: {
                      mode: 'nearest',
                      callbacks: {
                        title: function(context) {
                          return format_unixtime(context[0].raw.x / 1000);
                        },
                        beforeBody: function(context) {
                          const dataset = context[0].dataset;
                          const data = dataset.data[context[0].dataIndex];

                          return [
                            'Open: ' + data.o.toFixed(8),
                            'High: ' + data.h.toFixed(8),
                            'Low: ' + data.l.toFixed(8),
                            'Close: ' + data.c.toFixed(8)
                          ];
                        },
                        label: function(context) {
                          // Suppress the default body content
                          return null;
                        }
                      }
                    },
                    crosshair: {
                      line: {
                        color: '#000000',
                        width: 1
                      },
                      sync: {
                        enabled: false
                      },
                      zoom: {
                        enabled: false
                      }
                    }
                  }
                }
              });
            }

            if (depthData != null && ((depthData.bids != null && depthData.bids.length > 0) || (depthData.asks != null && depthData.asks.length > 0))) {
              var depthChartInstance = null;
              var depthBaseSymbol = (depthData.base_symbol || '#{marketdata.coin}');
              var depthQuoteSymbol = (depthData.quote_symbol || '#{marketdata.exchange}');
              var depthSpanOptions = (Array.isArray(depthData.span_options_pct) && depthData.span_options_pct.length > 0 ? depthData.span_options_pct : [1, 2.5, 5, 10, 25, 50]);
              var selectedDepthPct = Number(depthData.default_span_pct || 25);
              var selectedDepthMode = 'quote';
              var depthSamplesPerSide = 100;
              var depthComputedState = null;

              if (Array.isArray(depthSpanOptions) && depthSpanOptions.length > 0) {
                var hasDefault = depthSpanOptions.some(function(x) { return Number(x) === Number(selectedDepthPct); });

                if (!hasDefault)
                  selectedDepthPct = Number(depthSpanOptions[0]);
              }

              function formatDepthNumber(v) {
                return Number(v || 0).toLocaleString('en', {'minimumFractionDigits': 2, 'maximumFractionDigits': 8, 'useGrouping': true});
              }

              function formatDepthPrice(v) {
                return Number(v || 0).toLocaleString('en', {'minimumFractionDigits': 2, 'maximumFractionDigits': 8, 'useGrouping': true});
              }

              function formatDepthAxisTick(v) {
                var n = Number(v || 0);

                if (!(n > 0))
                  return '0';

                if (n >= 1)
                  return n.toFixed(4).replace(/\.0+$/, '').replace(/(\.\d*?)0+$/, '$1');

                if (n >= 0.01)
                  return n.toFixed(6).replace(/\.0+$/, '').replace(/(\.\d*?)0+$/, '$1');

                if (n >= 0.0001)
                  return n.toFixed(8).replace(/\.0+$/, '').replace(/(\.\d*?)0+$/, '$1');

                return n.toExponential(2);
              }

              function resolveDepthCenterPrice() {
                var cp = Number(depthData.center_price || 0);

                if (cp > 0)
                  return cp;

                var bestBid = 0;
                var bestAsk = 0;

                if (Array.isArray(depthData.bids)) {
                  depthData.bids.forEach(function(row) {
                    var p = Number(row.price || 0);
                    if (p > bestBid)
                      bestBid = p;
                  });
                }

                if (Array.isArray(depthData.asks)) {
                  depthData.asks.forEach(function(row) {
                    var p = Number(row.price || 0);
                    if (p > 0 && (bestAsk === 0 || p < bestAsk))
                      bestAsk = p;
                  });
                }

                if (bestBid > 0 && bestAsk > 0)
                  return (bestBid + bestAsk) / 2;

                return (bestBid > 0 ? bestBid : bestAsk);
              }

              function aggregateByPrice(rows, mode) {
                var byPrice = new Map();

                (Array.isArray(rows) ? rows : []).forEach(function(row) {
                  var price = Number(row.price || 0);
                  var quantity = Number(row.quantity || 0);
                  var totalQuote = Number(row.total_quote || (price * quantity) || 0);

                  if (!(price > 0) || !(quantity > 0))
                    return;

                  var value = (mode === 'base' ? quantity : totalQuote);
                  byPrice.set(price, (byPrice.get(price) || 0) + value);
                });

                return Array.from(byPrice.entries()).map(function(entry) {
                  return { price: Number(entry[0]), value: Number(entry[1]) };
                });
              }

              function buildCumulativeTables(mode) {
                var bids = aggregateByPrice(depthData.bids || [], mode).sort(function(a, b) { return b.price - a.price; });
                var asks = aggregateByPrice(depthData.asks || [], mode).sort(function(a, b) { return a.price - b.price; });

                var bidCum = [];
                var askCum = [];
                var running = 0;

                bids.forEach(function(level) {
                  running += level.value;
                  bidCum.push({ price: level.price, cumulative: running });
                });

                running = 0;
                asks.forEach(function(level) {
                  running += level.value;
                  askCum.push({ price: level.price, cumulative: running });
                });

                return {
                  bids: bidCum,
                  asks: askCum
                };
              }

              function cumulativeAtX(cumulativeRows, x, side) {
                if (!Array.isArray(cumulativeRows) || cumulativeRows.length === 0 || !(x > 0))
                  return 0;

                if (side === 'buy') {
                  if (x > cumulativeRows[0].price)
                    return 0;

                  for (var i = 0; i < cumulativeRows.length; i++) {
                    if (cumulativeRows[i].price < x)
                      return (i > 0 ? Number(cumulativeRows[i - 1].cumulative || 0) : 0);
                  }

                  return Number(cumulativeRows[cumulativeRows.length - 1].cumulative || 0);
                }

                if (x < cumulativeRows[0].price)
                  return 0;

                for (var j = 0; j < cumulativeRows.length; j++) {
                  if (cumulativeRows[j].price > x)
                    return (j > 0 ? Number(cumulativeRows[j - 1].cumulative || 0) : 0);
                }

                return Number(cumulativeRows[cumulativeRows.length - 1].cumulative || 0);
              }

              function buildLogGrid(minX, maxX, points) {
                var grid = [];

                if (!(minX > 0) || !(maxX > minX) || !(points > 1))
                  return grid;

                for (var i = 0; i < points; i++) {
                  var r = i / (points - 1);
                  grid.push(minX * Math.pow((maxX / minX), r));
                }

                return grid;
              }

              function computeDepthDatasets(centerPrice, spanPct, mode) {
                var p = Number(spanPct || 25) / 100;
                var xMin = (centerPrice > 0 ? (centerPrice / (1 + p)) : 0);
                var xMax = (centerPrice > 0 ? (centerPrice * (1 + p)) : 0);
                var tables = buildCumulativeTables(mode);
                var bidGrid = buildLogGrid(xMin, centerPrice, depthSamplesPerSide);
                var askGrid = buildLogGrid(centerPrice, xMax, depthSamplesPerSide);

                var bidData = bidGrid.map(function(x) {
                  return { x: x, y: cumulativeAtX(tables.bids, x, 'buy') };
                });

                var askData = askGrid.map(function(x) {
                  return { x: x, y: cumulativeAtX(tables.asks, x, 'sell') };
                });

                return {
                  bids: bidData,
                  asks: askData,
                  min: xMin,
                  max: xMax,
                  center: centerPrice,
                  tables: tables
                };
              }

              function depthValueAt(x, side) {
                if (depthComputedState == null || depthComputedState.tables == null)
                  return 0;

                return cumulativeAtX((side === 'buy' ? depthComputedState.tables.bids : depthComputedState.tables.asks), x, side);
              }

              function setDepthRangeButtonsActive(pct) {
                $('.depth-range-btn').removeClass('active');
                $('.depth-range-btn[data-pct="' + pct + '"]').addClass('active');
              }

              function setDepthModeButtonsActive(mode) {
                $('.depth-value-btn').removeClass('active');
                $('.depth-value-btn[data-mode="' + mode + '"]').addClass('active');
              }

              function setOrderbookCumulativeColumns(mode) {
                var root = $('#market-root');

                if (!root.length)
                  return;

                if (mode === 'base')
                  root.removeClass('market-depth-mode-quote').addClass('market-depth-mode-base');
                else
                  root.removeClass('market-depth-mode-base').addClass('market-depth-mode-quote');
