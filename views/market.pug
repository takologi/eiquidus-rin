                setDepthModeButtonsActive(selectedDepthMode);
                setOrderbookCumulativeColumns(selectedDepthMode);
                renderDepthChart();
              });
            }

            if (priceHistoryApiUrl != null && priceHistoryApiUrl !== '' && $('#price-history-30d').length > 0) {
              var priceHistoryChart = null;
              var priceHoverState = null;
              var activePriceHistoryRequest = null;

              function formatPriceNumber(v) {
                return Number(v || 0).toLocaleString('en', {'minimumFractionDigits': 2, 'maximumFractionDigits': 8, 'useGrouping': true});
              }

              function normalizeRows(rows) {
                var out = [];

                (Array.isArray(rows) ? rows : []).forEach(function(r) {
                  var x = Number(r.x);
                  var last = (r.last != null ? Number(r.last) : null);
                  var bid = (r.bid != null ? Number(r.bid) : null);
                  var ask = (r.ask != null ? Number(r.ask) : null);

                  if (!(x > 0) || isNaN(x))
                    return;

                  if (last != null && !(last > 0))
                    last = null;

                  if (bid != null && !(bid > 0))
                    bid = null;

                  if (ask != null && !(ask > 0))
                    ask = null;

                  if (bid != null && ask != null && ask < bid)
                    ask = bid;

                  out.push({ x: x, last: last, bid: bid, ask: ask });
                });

                return out.sort(function(a, b) { return a.x - b.x; });
              }

              function updatePriceHoverLabel(payload) {
                if (payload == null) {
                  $('#price-hover-value').text('Move cursor over price graph to inspect values');
                  return;
