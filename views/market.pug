              function updateDepthHoverLabel(payload) {
                if (payload == null) {
                  $('#depth-hover-value').text('Move cursor over depth graph to inspect buy/sell values');
                  return;
                }

                $('#depth-hover-value').html(
                  '<span class="depth-hover-side depth-hover-buy">Buy @ ' + formatDepthPrice(payload.buyX) + ' ' + depthQuoteSymbol + '<b>: ' + formatDepthNumber(payload.buyY) + ' ' + payload.depthUnit + '</b></span>' +
                  '<span class="depth-hover-side depth-hover-sell">Sell @ ' + formatDepthPrice(payload.sellX) + ' ' + depthQuoteSymbol + '<b>: ' + formatDepthNumber(payload.sellY) + ' ' + payload.depthUnit + '</b></span>'
                );
              }

              var depthHoverState = null;

              function setDepthHoverFromElement(chart, element) {
                if (chart == null || element == null || depthComputedState == null) {
                  depthHoverState = null;
                  updateDepthHoverLabel(null);
                  return;
                }

                const ds = (((chart.data || {}).datasets || [])[element.datasetIndex] || {});
                const point = (((ds.data || [])[element.index]) || null);

                if (point == null || !(Number(point.x) > 0)) {
                  depthHoverState = null;
                  updateDepthHoverLabel(null);
                  return;
                }

                const side = (element.datasetIndex === 0 ? 'buy' : 'sell');
                const x = Number(point.x);
                const yVal = Number(point.y || 0);
                const mirrorX = (depthComputedState.center > 0 ? ((depthComputedState.center * depthComputedState.center) / x) : 0);
                const mirrorSide = (side === 'buy' ? 'sell' : 'buy');
                const mirrorY = depthValueAt(mirrorX, mirrorSide);
                const depthUnit = (selectedDepthMode === 'base' ? depthBaseSymbol : depthQuoteSymbol);

                if (side === 'buy') {
                  depthHoverState = {
                    buyX: x,
                    buyY: yVal,
                    sellX: mirrorX,
                    sellY: mirrorY,
                    depthUnit: depthUnit
                  };
                } else {
                  depthHoverState = {
                    buyX: mirrorX,
                    buyY: mirrorY,
                    sellX: x,
                    sellY: yVal,
                    depthUnit: depthUnit
                  };
                }

                updateDepthHoverLabel(depthHoverState);
              }

              var depthHoverGuidePlugin = {
                id: 'depthHoverGuide',
                afterDatasetsDraw: function(chart) {
                  try {
                    if (depthComputedState == null || depthHoverState == null)
                      return;
                    var chartArea = chart.chartArea;
                    var xScale = chart.scales.x;
                    var yScale = chart.scales.y;
                    var pxBuy = xScale.getPixelForValue(Number(depthHoverState.buyX || 0));
                    var pxSell = xScale.getPixelForValue(Number(depthHoverState.sellX || 0));
                    var pyBuy = yScale.getPixelForValue(Number(depthHoverState.buyY || 0));
                    var pySell = yScale.getPixelForValue(Number(depthHoverState.sellY || 0));

                    var ctx = chart.ctx;
                    ctx.save();

                    // vertical guide lines for buy/sell x positions
                    ctx.setLineDash([]);
                    ctx.strokeStyle = 'rgba(255, 255, 255, 0.9)';
                    ctx.lineWidth = 0.8;

                    if (isFinite(pxBuy)) {
                      ctx.beginPath();
                      ctx.moveTo(pxBuy, chartArea.top);
                      ctx.lineTo(pxBuy, chartArea.bottom);
                      ctx.stroke();
                    }

                    if (isFinite(pxSell)) {
                      ctx.beginPath();
                      ctx.moveTo(pxSell, chartArea.top);
                      ctx.lineTo(pxSell, chartArea.bottom);
                      ctx.stroke();
                    }

                    // horizontal guide lines for both sides (same dashed style)
                    ctx.setLineDash([4, 3]);
                    ctx.strokeStyle = 'rgba(80,160,115,0.5)';
                    ctx.lineWidth = 0.8;
                    ctx.beginPath();
                    ctx.moveTo(chartArea.left, pyBuy);
                    ctx.lineTo(chartArea.right, pyBuy);
                    ctx.stroke();

                    ctx.strokeStyle = 'rgba(215,85,65,0.45)';
                    ctx.beginPath();
                    ctx.moveTo(chartArea.left, pySell);
                    ctx.lineTo(chartArea.right, pySell);
                    ctx.stroke();
                    ctx.setLineDash([]);

                    ctx.restore();
                  } catch (e) {
                    // swallow to keep hover listener healthy
                  }
                }
              };

              function renderDepthChart() {
                var centerPrice = resolveDepthCenterPrice();

                if (!(centerPrice > 0))
                  return;

                depthComputedState = computeDepthDatasets(centerPrice, selectedDepthPct, selectedDepthMode);
                var depthUnit = (selectedDepthMode === 'base' ? depthBaseSymbol : depthQuoteSymbol);

                if (depthChartInstance == null) {
                  depthChartInstance = new Chart('depth-chart', {
                    type: 'line',
                    data: {
                      datasets: [{
                        label: 'Buy depth (' + depthUnit + ')',
                        data: depthComputedState.bids,
                        borderColor: 'rgba(80, 160, 115, 1)',
                        backgroundColor: 'rgba(80, 160, 115, 0.10)',
                        pointRadius: 0,
                        pointHoverRadius: 0,
