                $('#price-hover-value').html(
                  '<span class="price-hover-part price-hover-bid">Bid (highest): <b>' + formatPriceNumber(payload.bid || 0) + ' #{marketdata.exchange}</b></span>' +
                  '<span class="price-hover-part price-hover-last">Last @ ' + format_unixtime(payload.x) + ': <b>' + formatPriceNumber(payload.last || 0) + ' #{marketdata.exchange}</b></span>' +
                  '<span class="price-hover-part price-hover-ask">Ask (lowest): <b>' + formatPriceNumber(payload.ask || 0) + ' #{marketdata.exchange}</b></span>'
                );
              }

              function buildDatasets(rows) {
                return [{
                  label: 'Bid (highest)',
                  data: rows.filter(function(r) { return r.bid != null; }).map(function(r) { return { x: r.x, y: r.bid }; }),
                  borderColor: 'rgba(80, 160, 115, 1)',
                  backgroundColor: 'rgba(80, 160, 115, 0)',
                  borderWidth: 0.8,
                  pointRadius: 0,
                  tension: 0,
                  fill: false
                }, {
                  label: 'Last price',
                  data: rows.filter(function(r) { return r.last != null; }).map(function(r) { return { x: r.x, y: r.last }; }),
                  borderColor: 'rgba(90, 140, 210, 1)',
                  backgroundColor: 'rgba(90, 140, 210, 0)',
                  borderWidth: 0.8,
                  pointRadius: 0,
                  tension: 0,
