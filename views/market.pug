                          enabled: false
                        }
                      }
                    },
                    plugins: [depthHoverGuidePlugin]
                  });
                } else {
                  depthChartInstance.data.datasets[0].label = 'Buy depth (' + depthUnit + ')';
                  depthChartInstance.data.datasets[1].label = 'Sell depth (' + depthUnit + ')';
                  depthChartInstance.data.datasets[0].data = depthComputedState.bids;
                  depthChartInstance.data.datasets[1].data = depthComputedState.asks;
                  depthChartInstance.options.scales.x.min = depthComputedState.min;
                  depthChartInstance.options.scales.x.max = depthComputedState.max;
                  depthChartInstance.options.scales.y.min = 0;
                  depthChartInstance.options.scales.y.title.text = 'Cumulative total (' + depthUnit + ')';
