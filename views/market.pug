              }

              function setPriceRangeButtonsActive(days) {
                $('.price-history-range-btn').removeClass('active');
                $('.price-history-range-btn[data-days="' + days + '"]').addClass('active');
              }

              var priceHoverGuidePlugin = {
                id: 'priceHoverGuide',
                afterEvent: function(chart, args) {
                  try {
                    const evt = (args ? args.event : null);

                    if (evt == null || evt.type === 'mouseout') {
                      priceHoverState = null;
                      updatePriceHoverLabel(null);
                      chart.draw();
                      return;
                    }

                    const active = chart.getElementsAtEventForMode(evt, 'nearest', { intersect: false, axis: 'x' }, false);

                    if (!Array.isArray(active) || active.length === 0) {
                      priceHoverState = null;
                      updatePriceHoverLabel(null);
                      chart.draw();
                      return;
                    }

                    const x = Number((((chart.data.datasets || [])[active[0].datasetIndex] || {}).data || [])[active[0].index].x || 0);

                    if (!(x > 0)) {
                      priceHoverState = null;
                      updatePriceHoverLabel(null);
                      chart.draw();
                      return;
                    }

                    var last = null;
                    var bid = null;
                    var ask = null;

                    (chart.data.datasets || []).forEach(function(ds) {
                      var match = (Array.isArray(ds.data) ? ds.data.find(function(p) { return Number(p.x) === x; }) : null);

                      if (match != null) {
                        if (ds.label.indexOf('Last') > -1)
                          last = Number(match.y || 0);
                        else if (ds.label.indexOf('Bid') > -1)
                          bid = Number(match.y || 0);
                        else if (ds.label.indexOf('Ask') > -1)
                          ask = Number(match.y || 0);
                      }
                    });

                    if (bid != null && ask != null && ask < bid)
                      ask = bid;

                    priceHoverState = {
                      x: x,
                      y: Number((((chart.data.datasets || [])[active[0].datasetIndex] || {}).data || [])[active[0].index].y || 0),
                      last: last,
                      bid: bid,
                      ask: ask
                    };

                    updatePriceHoverLabel(priceHoverState);
                    chart.draw();
                  } catch (e) {
                    priceHoverState = null;
                    updatePriceHoverLabel(null);
                  }
                },
                afterDatasetsDraw: function(chart) {
                  try {
                    if (priceHoverState == null)
                      return;

                    var yScale = chart.scales.y;
                    var xScale = chart.scales.x;
                    var chartArea = chart.chartArea;
                    var ctx = chart.ctx;

                    var px = xScale.getPixelForValue(Number(priceHoverState.x || 0));

                    function drawGuide(yValue, color) {
                      if (yValue == null || !isFinite(Number(yValue)))
                        return;

                      var py = yScale.getPixelForValue(Number(yValue));
                      if (!isFinite(py))
                        return;

                      ctx.strokeStyle = color;
                      ctx.lineWidth = 0.8;
                      ctx.setLineDash([2, 3]);
                      ctx.beginPath();
                      ctx.moveTo(chartArea.left, py);
                      ctx.lineTo(chartArea.right, py);
                      ctx.stroke();
                    }

                    ctx.save();
                    if (isFinite(px)) {
                      ctx.setLineDash([]);
                      ctx.strokeStyle = 'rgba(255, 255, 255, 0.9)';
                      ctx.lineWidth = 0.8;
                      ctx.beginPath();
                      ctx.moveTo(px, chartArea.top);
                      ctx.lineTo(px, chartArea.bottom);
                      ctx.stroke();
                    }
                    drawGuide(priceHoverState.last, 'rgba(90, 140, 210, 0.9)');
                    drawGuide(priceHoverState.bid, 'rgba(80, 160, 115, 0.9)');
                    drawGuide(priceHoverState.ask, 'rgba(215, 85, 65, 0.9)');
                    ctx.setLineDash([]);
                    ctx.restore();
                  } catch (e) {
                    // ignore hover draw errors
                  }
                }
              };

              function renderPriceChart(rows) {
                if (priceHistoryChart == null) {
                  priceHistoryChart = new Chart('price-history-30d', {
                    type: 'line',
                    data: {
                      datasets: buildDatasets(rows)
                    },
                    options: {
                      maintainAspectRatio: false,
                      events: ['mousemove', 'mouseout', 'touchstart', 'touchmove'],
                      interaction: {
                        mode: 'nearest',
                        intersect: false,
                        axis: 'x'
                      },
                      scales: {
                        x: {
                          type: 'linear',
                          ticks: {
                            callback: function(value) {
                              const dt = new Date(Number(value) * 1000);
                              return dt.toLocaleDateString('en', { month: 'short', day: 'numeric' });
                            }
                          },
                          title: {
                            display: true,
                            text: 'Date (UTC)'
                          }
                        },
                        y: {
                          title: {
                            display: true,
                            text: 'Price (' + '#{marketdata.exchange}' + ')'
                          }
                        }
                      },
                      plugins: {
