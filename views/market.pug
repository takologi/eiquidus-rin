                        pointRadius: 0,
                        pointHoverRadius: 0,
                        tension: 0,
                        borderWidth: 1.5,
                        fill: true
                      }]
                    },
                    options: {
                      maintainAspectRatio: false,
                      events: ['mousemove', 'mouseout', 'touchstart', 'touchmove'],
                      onHover: function(evt, activeEls, chart) {
                        try {
                          const active = (Array.isArray(activeEls) ? activeEls : []);

                          if (active.length > 0)
                            setDepthHoverFromElement(chart, active[0]);
                          else {
                            const fallback = chart.getElementsAtEventForMode(evt, 'nearest', { intersect: false, axis: 'x' }, false);

                            if (Array.isArray(fallback) && fallback.length > 0)
                              setDepthHoverFromElement(chart, fallback[0]);
                            else {
                              depthHoverState = null;
                              updateDepthHoverLabel(null);
                            }
                          }

                          chart.draw();
                        } catch (e) {
                          depthHoverState = null;
                          updateDepthHoverLabel(null);
                        }
                      },
                      interaction: {
                        mode: 'nearest',
                        intersect: false,
                        axis: 'x'
                      },
                      scales: {
                        x: {
                          type: 'logarithmic',
                          min: depthComputedState.min,
                          max: depthComputedState.max,
                          afterBuildTicks: function(scale) {
                            if (!(depthComputedState.min > 0) || !(depthComputedState.max > depthComputedState.min))
                              return;

                            const custom = [];
                            const parts = 7;

                            for (let i = 0; i <= parts; i++) {
                              const ratio = i / parts;
                              const val = depthComputedState.min * Math.pow((depthComputedState.max / depthComputedState.min), ratio);
                              custom.push({ value: val });
                            }

                            scale.ticks = custom;
                          },
                          ticks: {
