                        }
                      }
                    },
                    plugins: [priceHoverGuidePlugin]
                  });
                } else {
                  priceHistoryChart.data.datasets = buildDatasets(rows);
                  priceHistoryChart.update();
                }

                priceHoverState = null;
                updatePriceHoverLabel(null);
              }

              function loadPriceRange(days) {
                setPriceRangeButtonsActive(days);
                $('#price-hover-value').text('Loading historical market data...');

                if (activePriceHistoryRequest != null && typeof activePriceHistoryRequest.abort === 'function') {
                  try {
                    activePriceHistoryRequest.abort();
                  } catch (e) {
                    // ignore abort failures
                  }
                }

                activePriceHistoryRequest = $.getJSON(priceHistoryApiUrl, { range: days, max_points: 300 });
                activePriceHistoryRequest.done(function(response) {
                  var rows = normalizeRows((response && Array.isArray(response.points) ? response.points : []));

                  if (rows.length === 0) {
                    if (priceHistoryChart != null) {
                      priceHistoryChart.data.datasets = buildDatasets([]);
                      priceHistoryChart.update();
                    }

                    $('#price-hover-value').text('No historical data found for this range yet.');
                    return;
                  }

                  renderPriceChart(rows);
                  $('#price-hover-value').text('Move cursor over price graph to inspect values');
                });

                activePriceHistoryRequest.fail(function() {
                  $('#price-hover-value').text('Unable to load market history right now. Please try again.');
                });
              }

              $('.price-history-range-btn').on('click', function() {
                var days = ($(this).attr('data-days') || '30');
                loadPriceRange(days);
              });

              loadPriceRange('30');
            }
          });
