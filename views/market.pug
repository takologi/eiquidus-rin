                }, {
                  label: 'Ask (lowest)',
                  data: rows.filter(function(r) { return r.ask != null; }).map(function(r) { return { x: r.x, y: r.ask }; }),
                  borderColor: 'rgba(215, 85, 65, 1)',
                  backgroundColor: 'rgba(215, 85, 65, 0)',
                  borderWidth: 0.8,
                  pointRadius: 0,
                  tension: 0,
