script(type='text/javascript', src='https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?version=4.8.0&features=Intl')
script(type='text/javascript', src='https://cdn.jsdelivr.net/npm/luxon@3.4.3/build/global/luxon.min.js')
script.
  const configuredCoinDecimals = #{(settings.coin.decimals == null || isNaN(settings.coin.decimals) ? -1 : Number(settings.coin.decimals))};

  function get_display_decimals() {
    const parsed = parseInt(configuredCoinDecimals);

    if (isNaN(parsed) || parsed < 0)
      return null;
    else if (parsed > 8)
      return 8;
    else
      return parsed;
  }

  function format_number_for_display(value, options) {
    const displayDecimals = get_display_decimals();
    const opts = {
      minimumFractionDigits: (options && options.minimumFractionDigits != null ? options.minimumFractionDigits : 2),
      maximumFractionDigits: (options && options.maximumFractionDigits != null ? options.maximumFractionDigits : 8),
      useGrouping: (options && options.useGrouping != null ? options.useGrouping : true)
    };

    if (displayDecimals != null) {
      opts.minimumFractionDigits = displayDecimals;
      opts.maximumFractionDigits = displayDecimals;
    }

    return Number((value == null || value === '' || isNaN(value) ? 0 : value)).toLocaleString('en', opts);
  }

  function format_number_parts_for_display(value, options) {
    const formatted = format_number_for_display(value, options);
    const parts = formatted.split('.');

    return {
      full: formatted,
      integer: (parts.length > 0 ? parts[0] : formatted),
      decimal: (parts.length > 1 ? parts[1] : ''),
      hasDecimal: (parts.length > 1)
    };
  }

  function get_value_align_class() {
    return (get_display_decimals() == null ? 'text-center' : 'text-end');
  }

  function format_unixtime(unixtime, alt) {
    if (alt == null)
      alt = false;
    // check if this date should be displayed in utc or local timezone
    if (('#{settings.shared_pages.date_time.timezone}'.toLowerCase() == 'local' && !alt) || ('#{settings.shared_pages.date_time.timezone}'.toLowerCase() == 'utc' && alt))
      return luxon.DateTime.fromSeconds(unixtime).toLocal().toFormat('#{settings.shared_pages.date_time.display_format}');
    else
      return luxon.DateTime.fromSeconds(unixtime).toUTC().toFormat('#{settings.shared_pages.date_time.display_format}');
  }
  
  // Format decimal portion with spaces after every 3rd digit
  function format_decimal_with_spaces(decimalStr) {
    if (!decimalStr) return '';
    return decimalStr.replace(/(\d{3})/g, '$1 ').trim();
  }
  const txFlagsSettings = !{JSON.stringify({fork_height: settings.transaction_page.tx_flags.fork_height, signal_tags: settings.transaction_page.tx_flags.signal_tags, rin3_version: 0x52494e33, text: {not_analysed: settings.localization.tx_flags_not_analysed, version: settings.localization.tx_flags_version, signatures: settings.localization.tx_flags_signatures, unsigned: settings.localization.tx_flags_unsigned, cb_tag: settings.localization.tx_flags_cb_tag, rin3: settings.localization.tx_flags_rin3, forkid_prefork: settings.localization.tx_flags_forkid_prefork, legacy_postfork: settings.localization.tx_flags_legacy_postfork, unsigned_note: settings.localization.tx_flags_unsigned_note, coinbase: settings.localization.tx_flags_coinbase, signal_note: settings.localization.tx_flags_signal_note}})};

  function escape_html(text) {
    return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function tx_flags_badge(cls, label, title) {
    return '<span class="badge ' + cls + ' me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="' + escape_html(title) + '">' + escape_html(label) + '</span>';
  }

  function hashtype_short_name(hashtype) {
    const base = {1: 'ALL', 2: 'NONE', 3: 'SINGLE'}[hashtype & 0x1f];

    if (base == null)
      return '0x' + ('0' + hashtype.toString(16)).slice(-2);

    return base + (hashtype & 0x40 ? '+FID' : '') + (hashtype & 0x80 ? '+ACP' : '');
  }

  function hashtype_full_name(hashtype) {
    return hashtype_short_name(hashtype).replace('+FID', '|FORKID').replace('+ACP', '|ANYONECANPAY');
  }

  // short form of the tx flags as a row of badges
  // coinbase is not stored in the flags, it is shown only in the tx lists
  function render_tx_flags(flags, blockindex, coinbase) {
    const text = txFlagsSettings.text;
    let html = (coinbase == true ? tx_flags_badge('bg-white text-dark', 'C', text.coinbase) : '');

    if (flags == null)
      return '<span class="tx-flags">' + html + '<span class="text-muted" data-bs-toggle="tooltip" data-bs-placement="top" title="' + escape_html(text.not_analysed) + '">&mdash;</span></span>';

    const post_fork = (blockindex != null && blockindex >= txFlagsSettings.fork_height);

    // version
    if (flags.version == txFlagsSettings.rin3_version)
      html += tx_flags_badge('bg-info text-dark', 'RIN3', text.version + ' ' + flags.version + ': ' + text.rin3);
    else
      html += tx_flags_badge((flags.version == 1 || flags.version == 2 ? 'bg-light text-dark' : 'bg-warning text-dark'), 'v' + flags.version, text.version + ' ' + flags.version);

    // signature hashtypes
    (flags.sighash || []).forEach(function(hashtype) {
      const forkid = ((hashtype & 0x40) != 0);
      let cls = (forkid ? 'bg-success' : 'bg-light text-dark');
      let title = hashtype_full_name(hashtype) + ' (' + text.signatures.toLowerCase() + ': ' + flags.sigs + ')';

      if (forkid && !post_fork) {
        cls = 'bg-warning text-dark';
        title += ' - ' + text.forkid_prefork.replace('{1}', txFlagsSettings.fork_height);
      } else if (!forkid && post_fork) {
        cls = 'bg-danger';
        title += ' - ' + text.legacy_postfork.replace('{1}', txFlagsSettings.fork_height);
      }

      html += tx_flags_badge(cls, hashtype_short_name(hashtype), title);
    });

    // inputs without an ecdsa signature
    if (flags.unsigned > 0)
      html += tx_flags_badge('bg-warning text-dark', 'NOSIG ×' + flags.unsigned, text.unsigned + ': ' + flags.unsigned + ' - ' + text.unsigned_note);

    // coinbase tag
    if (flags.cb_tag != null) {
      const signal = (txFlagsSettings.signal_tags || []).find(function(signal_tag) { return flags.cb_tag.indexOf(signal_tag.tag) > -1; });
      const label = (flags.cb_tag.length > 24 ? flags.cb_tag.substring(0, 23) + '…' : flags.cb_tag);

      if (signal != null)
        html += tx_flags_badge('bg-success', label, text.cb_tag + ': ' + flags.cb_tag + ' - ' + signal.label + ' (' + text.signal_note.toLowerCase() + ')');
      else
        html += tx_flags_badge('border border-info text-info', label, text.cb_tag + ': ' + flags.cb_tag);
    }

    return '<span class="tx-flags">' + html + '</span>';
  }

  // short form of the tx flags from an internal datatables row that carries a 'tx_flags:{"flags":...,"coinbase":...}' element
  function render_tx_flags_from_row(data, blockindex) {
    const elem = data.find(function(value) { return (typeof value === 'string' && value.indexOf('tx_flags:') == 0); });

    if (elem == null)
      return '';

    const payload = JSON.parse(elem.substring('tx_flags:'.length));

    return render_tx_flags(payload.flags, blockindex, payload.coinbase);
  }

  // fill server-rendered placeholders: span.tx-flags-placeholder(data-flags='...' data-height='...' data-coinbase='true|false')
  $(document).ready(function() {
    $('.tx-flags-placeholder').each(function() {
      const raw_flags = $(this).attr('data-flags');

      $(this).replaceWith(render_tx_flags((raw_flags == null || raw_flags == '' ? null : JSON.parse(raw_flags)), parseInt($(this).attr('data-height')), $(this).attr('data-coinbase') == 'true'));
    });

    if (typeof enableTooltips === 'function')
      enableTooltips();
  });
